---
changefreq: monthly
priority: 0.8
layout: layouts/base.njk
---
{{ navHtml | safe }}

<nav class="bike-rank-dock" id="bikeRankDock" aria-label="{% if showcaseType == 'yachts' %}Luxury yacht fleet rankings{% elif showcaseType == 'airplanes' %}Airplanes &amp; aerospace rankings{% else %}Sports bike rankings{% endif %}" data-showcase="{% if showcaseType == 'yachts' %}yachts{% elif showcaseType == 'airplanes' %}airplanes{% else %}bikes{% endif %}">
  <div class="bike-dock-header" title="{% if showcaseType == 'yachts' %}Superyacht Fleet Telemetry{% elif showcaseType == 'airplanes' %}Avionics Fleet Telemetry{% else %}Superbike Telemetry Grid{% endif %}">
    <i class="fa-solid {% if showcaseType == 'yachts' %}fa-anchor{% elif showcaseType == 'airplanes' %}fa-plane{% else %}fa-motorcycle{% endif %}"></i>
    <span class="bike-dock-shift-led"></span>
  </div>
  <div class="bike-dock-track">
    <div class="bike-dock-rpm-fill" id="bikeRpmFill"></div>
    <div class="bike-dock-nodes" id="bikeDockNodes"></div>
  </div>
  <a href="#conclusion" class="bike-dock-finish" id="bikeDockFinish" title="{% if showcaseType == 'yachts' %}Anchorage / Final Verdict{% elif showcaseType == 'airplanes' %}Touchdown / Final Verdict{% else %}Checkered Flag / Final Verdict{% endif %}" aria-label="Go to conclusion">
    <i class="fa-solid {% if showcaseType == 'yachts' %}fa-compass{% elif showcaseType == 'airplanes' %}fa-plane-arrival{% else %}fa-flag-checkered{% endif %}"></i>
  </a>
</nav>

  <div class="page-wrap">
    <div class="content">
{{ content | safe }}
    </div>
    <section class="newsletter-section" aria-label="Subscribe to newsletter">
      <div class="newsletter-card">
        <div class="newsletter-glow"></div>
        <div class="newsletter-inner">
          <div class="newsletter-badge"><i class="fa-solid fa-sparkles"></i> STAY AHEAD</div>
          <h3 class="newsletter-title">Get the World's Best Top 10 Lists</h3>
          <p class="newsletter-sub">Join thousands of enthusiasts. Receive our curated rankings, deep-dive specs, and exclusive editorial analysis directly in your inbox.</p>
          <form class="newsletter-form">
            <div class="newsletter-input-group">
              <i class="fa-solid fa-envelope newsletter-icon"></i>
              <input type="email" class="newsletter-input" placeholder="Enter your email address" required autocomplete="email" aria-label="Email address">
              <button type="submit" class="newsletter-submit-btn">
                <span>Subscribe</span> <i class="fa-solid fa-paper-plane"></i>
              </button>
            </div>
            <div class="newsletter-feedback" style="display:none;"></div>
          </form>
          <span class="newsletter-privacy-note">Zero spam. Unsubscribe at any time. Read our <a href="/privacy-policy.html">Privacy Policy</a>.</span>
        </div>
      </div>
    </section>
    <div class="footer">
{{ footerHtml | safe }}
    </div>
  </div>
{{ lightboxHtml | safe }}
{{ pageScriptHtml | safe }}
{{ mobileMenuHtml | safe }}

<script>
  (function() {
    function initBikeRankDock() {
      var dock = document.getElementById('bikeRankDock');
      var nodesContainer = document.getElementById('bikeDockNodes');
      var rpmFill = document.getElementById('bikeRpmFill');
      var cards = document.querySelectorAll('.showcase-card');
      if (!dock || !nodesContainer || cards.length === 0) return;

      var isYachts = dock.dataset.showcase === 'yachts' || window.location.pathname.includes('luxury-yachts');
      var isAirplanes = dock.dataset.showcase === 'airplanes' || window.location.pathname.includes('top-10-airplanes');

      var bikeColors = {
        1:  { accent: '#dc2626', accent2: '#f87171', glow: 'rgba(220, 38, 38, 0.45)', maker: 'DUCATI' },
        2:  { accent: '#2563eb', accent2: '#06b6d4', glow: 'rgba(37, 99, 235, 0.45)', maker: 'BMW' },
        3:  { accent: '#ef4444', accent2: '#a855f7', glow: 'rgba(239, 68, 68, 0.45)', maker: 'APRILIA' },
        4:  { accent: '#16a34a', accent2: '#4ade80', glow: 'rgba(220, 38, 38, 0.45)', maker: 'KAWASAKI' },
        5:  { accent: '#1d4ed8', accent2: '#38bdf8', glow: 'rgba(29, 78, 216, 0.45)', maker: 'YAMAHA' },
        6:  { accent: '#0284c7', accent2: '#eab308', glow: 'rgba(2, 132, 199, 0.45)', maker: 'SUZUKI' },
        7:  { accent: '#dc2626', accent2: '#ffffff', glow: 'rgba(220, 38, 38, 0.45)', maker: 'HONDA' },
        8:  { accent: '#b91c1c', accent2: '#f59e0b', glow: 'rgba(185, 28, 28, 0.45)', maker: 'MV AGUSTA' },
        9:  { accent: '#ea580c', accent2: '#fb923c', glow: 'rgba(234, 88, 12, 0.45)', maker: 'KTM' },
        10: { accent: '#0891b2', accent2: '#06b6d4', glow: 'rgba(8, 145, 178, 0.45)', maker: 'ENERGICA' }
      };

      var yachtColors = {
        1:  { accent: '#0284c7', accent2: '#38bdf8', glow: 'rgba(2, 132, 199, 0.45)', maker: 'REV OCEAN' },
        2:  { accent: '#2563eb', accent2: '#93c5fd', glow: 'rgba(37, 99, 235, 0.45)', maker: 'FEADSHIP' },
        3:  { accent: '#f59e0b', accent2: '#fbbf24', glow: 'rgba(245, 158, 11, 0.45)', maker: 'LÜRSSEN' },
        4:  { accent: '#0d9488', accent2: '#2dd4bf', glow: 'rgba(13, 148, 136, 0.45)', maker: 'BENETTI' },
        5:  { accent: '#6366f1', accent2: '#a5b4fc', glow: 'rgba(99, 102, 241, 0.45)', maker: 'HEESEN' },
        6:  { accent: '#d97706', accent2: '#fcd34d', glow: 'rgba(217, 119, 6, 0.45)', maker: 'AMELS' },
        7:  { accent: '#10b981', accent2: '#6ee7b7', glow: 'rgba(16, 185, 129, 0.45)', maker: 'SANLORENZO' },
        8:  { accent: '#1d4ed8', accent2: '#60a5fa', glow: 'rgba(29, 78, 216, 0.45)', maker: 'SYBARIS' },
        9:  { accent: '#06b6d4', accent2: '#22d3ee', glow: 'rgba(6, 182, 212, 0.45)', maker: 'RIVA' },
        10: { accent: '#84cc16', accent2: '#bef264', glow: 'rgba(132, 204, 22, 0.45)', maker: 'SUNREEF' }
      };

      var planeColors = {
        1:  { accent: '#d97706', accent2: '#fbbf24', glow: 'rgba(217, 119, 6, 0.45)', maker: 'BOMBARDIER' },
        2:  { accent: '#2563eb', accent2: '#60a5fa', glow: 'rgba(37, 99, 235, 0.45)', maker: 'GULFSTREAM' },
        3:  { accent: '#059669', accent2: '#34d399', glow: 'rgba(5, 150, 105, 0.45)', maker: 'DASSAULT' },
        4:  { accent: '#dc2626', accent2: '#f87171', glow: 'rgba(220, 38, 38, 0.45)', maker: 'BOOM AERO' },
        5:  { accent: '#0284c7', accent2: '#38bdf8', glow: 'rgba(2, 132, 199, 0.45)', maker: 'EMBRAER' },
        6:  { accent: '#7c3aed', accent2: '#a78bfa', glow: 'rgba(124, 58, 237, 0.45)', maker: 'CESSNA' },
        7:  { accent: '#0369a1', accent2: '#7dd3fc', glow: 'rgba(3, 105, 161, 0.45)', maker: 'AIRBUS' },
        8:  { accent: '#16a34a', accent2: '#4ade80', glow: 'rgba(22, 163, 74, 0.45)', maker: 'EVE MOBILITY' },
        9:  { accent: '#ea580c', accent2: '#fb923c', glow: 'rgba(234, 88, 12, 0.45)', maker: 'CIRRUS' },
        10: { accent: '#0891b2', accent2: '#22d3ee', glow: 'rgba(8, 145, 178, 0.45)', maker: 'ZEROAVIA' }
      };

      var colorMap = isAirplanes ? planeColors : (isYachts ? yachtColors : bikeColors);

      nodesContainer.innerHTML = '';
      var dockNodes = [];

      function sanitize(str) {
        if (!str) return '';
        return String(str).replace(/[&<>"']/g, function(m) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
        });
      }

      cards.forEach(function(card, idx) {
        var rankNum = idx + 1;
        card.id = (isAirplanes ? 'plane-' : (isYachts ? 'yacht-' : 'bike-')) + rankNum;
        card.style.scrollMarginTop = '88px';

        var h2 = card.querySelector('h2');
        var fullName = h2 ? h2.textContent.trim() : ((isAirplanes ? 'Plane #' : (isYachts ? 'Yacht #' : 'Bike #')) + rankNum);

        var cardTop = card.querySelector('.card-top');
        if (cardTop && !cardTop.querySelector('.vote-btn')) {
          var category = isAirplanes ? 'airplanes' : (isYachts ? 'luxury-yachts' : 'sports-bikes');
          var imgEl = card.querySelector('img');
          var imgMatch = imgEl ? (imgEl.getAttribute('src') || imgEl.src || '').match(/\/(?:bikes|yachts|airplanes)\/([^\/]+)\//) : null;
          var itemSlug = (imgMatch ? imgMatch[1] : '') || fullName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || ('item-' + rankNum);
          var voteBtn = document.createElement('button');
          voteBtn.className = 'vote-btn showcase-vote-btn';
          voteBtn.dataset.category = category;
          voteBtn.dataset.item = itemSlug;
          voteBtn.setAttribute('aria-label', 'Vote for ' + fullName);
          voteBtn.innerHTML = '<i class="fa-solid fa-heart vote-heart"></i> <span class="vote-text">Like</span> <span class="vote-count">0</span>';
          cardTop.appendChild(voteBtn);
        }

        var stat1 = '';
        var stat2 = '';
        var stat1Icon = isAirplanes ? 'fa-gauge-high' : (isYachts ? 'fa-ruler-horizontal' : 'fa-bolt');
        var stat2Icon = isAirplanes ? 'fa-route' : (isYachts ? 'fa-water' : 'fa-gauge-high');

        card.querySelectorAll('.spec-pill').forEach(function(pill) {
          var lbl = pill.querySelector('.label');
          var val = pill.querySelector('.val');
          if (lbl && val) {
            var text = lbl.textContent.toUpperCase();
            if (isAirplanes) {
              if (text.includes('SPEED') || text.includes('VMAX') || text.includes('VITESSE') || text.includes('VELOCIDAD') || text.includes('VELOCITÀ') || text.includes('スピード') || text.includes('속도') || text.includes('गति') || text.includes('سرعة')) {
                stat1 = val.textContent.trim();
              }
              if (text.includes('RANGE') || text.includes('REICHWEITE') || text.includes('RAYON') || text.includes('ALCANCE') || text.includes('AUTONOMIA') || text.includes('航続') || text.includes('항속') || text.includes('रेंज') || text.includes('مدى')) {
                stat2 = val.textContent.trim();
              }
            } else if (isYachts) {
              if (text.includes('LENGTH') || text.includes('LÄNGE') || text.includes('LONGUEUR') || text.includes('ESLORA') || text.includes('LUNGHEZZA') || text.includes('全長') || text.includes('길이') || text.includes('लंबाई') || text.includes('طول') || text.includes('COMPRIMENTO')) {
                stat1 = val.textContent.trim();
              }
              if (text.includes('RANGE') || text.includes('REICHWEITE') || text.includes('RAYON') || text.includes('ALCANCE') || text.includes('AUTONOMIA') || text.includes('航続') || text.includes('항속') || text.includes('रेंज') || text.includes('مدى')) {
                stat2 = val.textContent.trim();
              }
            } else {
              if (text.includes('POWER') || text.includes('LEISTUNG') || text.includes('PUISSANCE') || text.includes('POTENCIA') || text.includes('POTENZA') || text.includes('パワー') || text.includes('출력') || text.includes('शक्ति') || text.includes('قوة')) {
                stat1 = val.textContent.trim();
              }
              if (text.includes('SPEED') || text.includes('VMAX') || text.includes('VITESSE') || text.includes('VELOCIDAD') || text.includes('VELOCITÀ') || text.includes('スピード') || text.includes('속도') || text.includes('गति') || text.includes('سرعة')) {
                stat2 = val.textContent.trim();
              }
            }
          }
        });

        var theme = colorMap[rankNum] || { accent: '#0284c7', accent2: '#38bdf8', glow: 'rgba(2, 132, 199, 0.4)', maker: (isYachts ? 'YACHT' : 'BIKE') };

        var node = document.createElement('button');
        node.className = 'bike-dock-node' + (rankNum === 1 ? ' active' : '');
        node.setAttribute('aria-label', fullName + ' rank ' + rankNum);
        node.dataset.rank = rankNum;
        node.style.setProperty('--bike-accent', theme.accent);
        node.style.setProperty('--bike-accent2', theme.accent2);
        node.style.setProperty('--bike-glow', theme.glow);

        var padRank = rankNum < 10 ? '0' + rankNum : rankNum;

        node.innerHTML = `
          <span class="bike-node-gear">${padRank}</span>
          <div class="bike-hud-flyout">
            <div class="bike-hud-header">
              <span class="bike-hud-rank">#${padRank}</span>
              <span class="bike-hud-maker">${sanitize(theme.maker)}</span>
            </div>
            <div class="bike-hud-name">${sanitize(fullName)}</div>
            ${(stat1 || stat2) ? `
            <div class="bike-hud-telemetry">
              ${stat1 ? `<span class="bike-hud-stat"><i class="fa-solid ${stat1Icon}"></i> ${sanitize(stat1)}</span>` : ''}
              ${stat2 ? `<span class="bike-hud-stat"><i class="fa-solid ${stat2Icon}"></i> ${sanitize(stat2)}</span>` : ''}
            </div>` : ''}
          </div>
        `;

        node.addEventListener('click', function(e) {
          e.preventDefault();
          node.classList.add('revving');
          setTimeout(function() { node.classList.remove('revving'); }, 350);
          card.scrollIntoView({ behavior: 'smooth' });
        });

        nodesContainer.appendChild(node);
        dockNodes.push({ node: node, card: card, rankNum: rankNum, theme: theme });
      });

      var finishBtn = document.getElementById('bikeDockFinish');
      if (finishBtn) {
        finishBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var conclusion = document.querySelector('.content > h2:last-of-type') || document.querySelector('h2:last-of-type');
          if (conclusion) conclusion.scrollIntoView({ behavior: 'smooth' });
          else window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        });
      }

      var activeRank = 1;
      function updateActiveRank(rank) {
        if (activeRank === rank && document.querySelector('.bike-dock-node.active')) return;
        activeRank = rank;

        dockNodes.forEach(function(item) {
          if (item.rankNum === rank) {
            item.node.classList.add('active');
            dock.style.setProperty('--active-bike-accent', item.theme.accent);
            dock.style.setProperty('--active-bike-accent2', item.theme.accent2);
            dock.style.setProperty('--active-bike-glow', item.theme.glow);
          } else {
            item.node.classList.remove('active');
          }
        });

        if (rpmFill) {
          var pct = Math.min(100, Math.max(8, ((rank) / cards.length) * 100));
          rpmFill.style.height = pct + '%';
        }
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var rank = parseInt(entry.target.id.replace(/^[a-z]+-/, ''));
              if (!isNaN(rank)) updateActiveRank(rank);
            }
          });
        }, { rootMargin: '-20% 0px -55% 0px', threshold: 0.05 });

        cards.forEach(function(card) { observer.observe(card); });
      }

      updateActiveRank(1);

      if (typeof window.initVoting === 'function') {
        window.initVoting();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBikeRankDock);
    } else {
      initBikeRankDock();
    }
  })();
</script>
