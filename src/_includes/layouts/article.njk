---
changefreq: monthly
priority: 0.8
layout: layouts/base.njk
---
{{ navHtml | safe }}
{% if family == "static" %}
{{ mobileMenuHtml | safe }}
{% endif %}
  <div class="page-wrap">
    <div class="content">
{{ content | safe }}
    </div>
    {% if family != "static" %}
    <section class="newsletter-section" aria-label="Subscribe to newsletter">
      <div class="newsletter-card">
        <div class="newsletter-glow"></div>
        <div class="newsletter-inner">
          <div class="newsletter-badge"><i class="fa-solid fa-sparkles"></i> STAY AHEAD</div>
          <h3 class="newsletter-title">Get the World's Best Top 10 Lists</h3>
          <p class="newsletter-sub">Join thousands of enthusiasts. Receive our curated rankings, deep-dive specs, and exclusive editorial analysis directly in your inbox.</p>
          <form class="newsletter-form">
            <div class="newsletter-input-group">
              <i class="fa-solid fa-envelope newsletter-icon"></i>
              <input type="email" class="newsletter-input" placeholder="Enter your email address" required autocomplete="email" aria-label="Email address">
              <button type="submit" class="newsletter-submit-btn">
                <span>Subscribe</span> <i class="fa-solid fa-paper-plane"></i>
              </button>
            </div>
            <div class="newsletter-feedback" style="display:none;"></div>
          </form>
          <span class="newsletter-privacy-note">Zero spam. Unsubscribe at any time. Read our <a href="/privacy-policy.html">Privacy Policy</a>.</span>
        </div>
      </div>
    </section>
    {% endif %}
    <div class="footer">
{{ footerHtml | safe }}
    </div>
  </div>
{% if family != "static" %}
{{ mobileMenuHtml | safe }}
{% endif %}
